    "cf-typegen": "npm run cf-typegen --workspaces --if-present"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  },
