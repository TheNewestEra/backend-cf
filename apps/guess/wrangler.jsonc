{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "game-guess-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Lets `./src/db/migrations.ts` import a generated `.sql` file as raw
  // text at bundle time — required by `drizzle-orm/durable-sqlite/migrator`
  // (see GameDO's constructor), which needs each migration's SQL as an
  // in-memory string rather than something read off disk at runtime (a
  // Durable Object can't do that). Build-level config, not a per-environment
  // one, so unlike `routes`/bindings below this isn't repeated under `env`.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom Domain per environment — see apps/accounts/wrangler.jsonc for
  // the naming scheme and the session-cookie caveat.
  "routes": [
    {
      "pattern": "dev.api.guess.ryanb.co.za",
      "custom_domain": true
    }
  ],
  // Unnamed/top-level config == "dev" (deployed as `game-guess-worker`, no
  // --env flag needed). NOTE: the producer/consumer queue names below
  // ("game-generation-dev" vs "game-generation") are a pre-existing
  // mismatch carried forward as-is — out of scope for this change. The
  // staging/production envs below use matching names, so this mismatch is
  // not repeated there.
  // Workers AI: a text model generates 5 round prompts, an image model
  // renders each into a picture.
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Flagship — same "timer" app across every environment, on
  // purpose: it's how every tunable knob this service has gets changed
  // without a redeploy (see guess.constants.ts, and @game-worker/shared's
  // lobby.ts/game-session.ts for the two flags below shared with `puzzle`).
  // No "dev-mode" flag any more — each knob is just its own flag, so
  // testing a different value means changing that flag directly instead of
  // flipping a mode and hoping a second "-override-" flag holds what you
  // want. This service's own flags: "guess-time-seconds", "round-count",
  // "guess-max-score", "guess-min-score", "post-round-seconds",
  // "guess-match-threshold" (0-1 fraction of the answer's significant words
  // a guess must cover to count as correct — see guess-matching.ts's
  // isGuessCorrect()). Shared with
  // `puzzle` (exact same flag key, read independently by each service):
  // "lobby-countdown-seconds", "max-theme-length", "max-player-length",
  // "preset-themes" (see @game-worker/shared's ai.ts — an object/array flag
  // of curated theme strings; leave unset/empty to let the model keep
  // inventing its own theme when a game doesn't have one).
  // `puzzle` also has its own puzzle-time-*/grid-size-*/puzzle-*-score
  // flags on this same app.
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
    }
  ],
  // Shared with `puzzle` — round images live at `games/<gameId>/<index>.png`
  // (see guess.constants.ts).
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "game-guess-images"
    }
  ],
  // No D1 binding here on purpose — this service has no tables of its own.
  // Catalog status and score recording go through the BROWSE/LEADERBOARD
  // RPC bindings below instead of a direct database binding.
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "game-accounts-worker",
      "entrypoint": "AccountsService"
    },
    {
      "binding": "BROWSE",
      "service": "game-browse-worker",
      "entrypoint": "CatalogService"
    },
    {
      "binding": "LEADERBOARD",
      "service": "game-leaderboard-worker",
      "entrypoint": "LeaderboardService"
    }
  ],
  // One DO instance per game (getByName(gameId)). Owns the game's durable
  // state (prompts, round/image status, guesses) and pushes live progress
  // to every connected WebSocket as the queue consumer calls its RPC
  // methods.
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_DO",
        "class_name": "GameDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameDO"
      ]
    }
  ],
  // POST /games enqueues a generation job; the queue consumer (same
  // Worker) does the actual AI work off the request path.
  "queues": {
    "producers": [
      {
        "queue": "game-generation-dev",
        "binding": "GAME_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "game-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "game-generation-dlq"
      }
    ]
  },
  // See apps/accounts/wrangler.jsonc for why binding arrays are fully
  // re-declared per named environment rather than inherited. Each named
  // env's service bindings target the sibling Workers deployed to the
  // *same* environment; queues/R2 bucket are separate physical resources
  // per env so staging/prod generation traffic never touches dev data.
  "env": {
    "staging": {
      "name": "game-guess-worker-staging",
      "routes": [
        {
          "pattern": "staging.api.guess.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "game-guess-images-staging"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-staging",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "BROWSE",
          "service": "game-browse-worker-staging",
          "entrypoint": "CatalogService"
        },
        {
          "binding": "LEADERBOARD",
          "service": "game-leaderboard-worker-staging",
          "entrypoint": "LeaderboardService"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_DO",
            "class_name": "GameDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "GameDO"
          ]
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "game-generation-staging",
            "binding": "GAME_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "game-generation-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "game-generation-dlq-staging"
          }
        ]
      }
    },
    "production": {
      "name": "game-guess-worker-prod",
      // Prod-only OTel export — see apps/accounts/wrangler.jsonc for what
      // "k8s-logs"/"k8s" are and why this only appears here.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "destinations": [
            "k8s-logs"
          ],
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "destinations": [
            "k8s"
          ],
          "head_sampling_rate": 1
        }
      },
      "routes": [
        {
          "pattern": "api.guess.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "game-guess-images-prod"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-prod",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "BROWSE",
          "service": "game-browse-worker-prod",
          "entrypoint": "CatalogService"
        },
        {
          "binding": "LEADERBOARD",
          "service": "game-leaderboard-worker-prod",
          "entrypoint": "LeaderboardService"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_DO",
            "class_name": "GameDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "GameDO"
          ]
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "game-generation-prod",
            "binding": "GAME_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "game-generation-prod",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "game-generation-dlq-prod"
          }
        ]
      }
    }
  }
}
