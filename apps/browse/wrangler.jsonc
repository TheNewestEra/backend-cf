{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "game-browse-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom Domain per environment — see apps/accounts/wrangler.jsonc for
  // the naming scheme and the session-cookie caveat.
  "routes": [
    {
      "pattern": "dev.api.browse.ryanb.co.za",
      "custom_domain": true
    }
  ],
  // Owns `catalog` + `ratings` — the cross-game index used by the browse
  // page and post-session ratings. The `guess` and `puzzle` Workers write
  // to it through the `CatalogService` RPC entrypoint (see src/index.ts)
  // rather than binding this database directly, since a Durable Object
  // can't be listed/queried across instances but this table can.
  // Unnamed/top-level config == "dev" (deployed as `game-browse-worker`,
  // no --env flag needed).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-worker-catalog",
      "database_id": "cd1e3d8e-eec2-4020-91b6-7adf07247d06",
      "migrations_dir": "../../migrations"
    }
  ],
  // Same bucket `guess`/`puzzle` write their images to (see their
  // wrangler.jsonc). Browse never writes here — it only reads back
  // whatever `thumbnail_key` those services recorded via
  // `markCatalogReady`, to serve GET /api/catalog/{id}/thumbnail.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "game-guess-images"
    }
  ],
  // Cloudflare Flagship — same app every other service shares (see e.g.
  // apps/puzzle/wrangler.jsonc's fuller comment on this binding). This
  // service has no tunable knobs of its own yet; the only flag it reads
  // today is "openapi-routes-enabled" (see @game-worker/shared/openapi-gate),
  // gating /openapi.json and /docs.
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
    }
  ],
  // Session lookups for the "created by friends" filter — same
  // ACCOUNTS-RPC pattern as apps/leaderboard's wrangler.jsonc (see its
  // comment on this binding). FRIENDS resolves the viewer's friend list for
  // that same filter, via apps/friends' FriendsService.
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "game-accounts-worker",
      "entrypoint": "AccountsService"
    },
    {
      "binding": "FRIENDS",
      "service": "game-friends-worker",
      "entrypoint": "FriendsService"
    }
  ],
  // See apps/accounts/wrangler.jsonc for why binding arrays are fully
  // re-declared per named environment rather than inherited.
  "env": {
    "staging": {
      "name": "game-browse-worker-staging",
      "routes": [
        {
          "pattern": "staging.api.browse.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-staging",
          "database_id": "75c2c0c7-0671-48bb-a183-6add29839f9d",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "game-guess-images-staging"
        }
      ],
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-staging",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "FRIENDS",
          "service": "game-friends-worker-staging",
          "entrypoint": "FriendsService"
        }
      ]
    },
    "production": {
      "name": "game-browse-worker-prod",
      // Prod-only OTel export — see apps/accounts/wrangler.jsonc for what
      // "k8s-logs"/"k8s" are and why this only appears here.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "destinations": [
            "k8s-logs"
          ],
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "destinations": [
            "k8s"
          ],
          "head_sampling_rate": 1
        }
      },
      "routes": [
        {
          "pattern": "api.browse.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-prod",
          "database_id": "44482ca7-ce2a-4d7a-a2f4-64e4d4825637",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "game-guess-images-prod"
        }
      ],
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-prod",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "FRIENDS",
          "service": "game-friends-worker-prod",
          "entrypoint": "FriendsService"
        }
      ]
    }
  }
}
