{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "game-browse-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Custom Domain per environment — see apps/accounts/wrangler.jsonc for
	// the naming scheme and the session-cookie caveat.
	"routes": [
		{
			"pattern": "dev.api.browse.ryanb.co.za",
			"custom_domain": true
		}
	],
	// Owns `catalog` + `ratings` — the cross-game index used by the browse
	// page and post-session ratings. The `guess` and `puzzle` Workers write
	// to it through the `CatalogService` RPC entrypoint (see src/index.ts)
	// rather than binding this database directly, since a Durable Object
	// can't be listed/queried across instances but this table can.
	// Unnamed/top-level config == "dev" (deployed as `game-browse-worker`,
	// no --env flag needed).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "game-worker-catalog",
			"database_id": "cd1e3d8e-eec2-4020-91b6-7adf07247d06",
			"migrations_dir": "../../migrations"
		}
	],
	// See apps/accounts/wrangler.jsonc for why binding arrays are fully
	// re-declared per named environment rather than inherited.
	"env": {
		"staging": {
			"name": "game-browse-worker-staging",
			"routes": [
				{
					"pattern": "staging.api.browse.ryanb.co.za",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "game-worker-catalog-staging",
					"database_id": "75c2c0c7-0671-48bb-a183-6add29839f9d",
					"migrations_dir": "../../migrations"
				}
			]
		},
		"production": {
			"name": "game-browse-worker-prod",
			"routes": [
				{
					"pattern": "api.browse.ryanb.co.za",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "game-worker-catalog-prod",
					"database_id": "44482ca7-ce2a-4d7a-a2f4-64e4d4825637",
					"migrations_dir": "../../migrations"
				}
			]
		}
	}
}
