{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "game-puzzle-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Lets `./src/db/migrations.ts` import a generated `.sql` file as raw
  // text at bundle time — required by `drizzle-orm/durable-sqlite/migrator`
  // (see PuzzleDO's constructor), which needs each migration's SQL as an
  // in-memory string rather than something read off disk at runtime (a
  // Durable Object can't do that). Build-level config, not a per-environment
  // one, so unlike `routes`/bindings below this isn't repeated under `env`.
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom Domain per environment — see apps/accounts/wrangler.jsonc for
  // the naming scheme and the session-cookie caveat.
  "routes": [
    {
      "pattern": "dev.api.puzzle.ryanb.co.za",
      "custom_domain": true
    }
  ],
  // Unnamed/top-level config == "dev" (deployed as `game-puzzle-worker`, no
  // --env flag needed). NOTE: the producer/consumer queue names below
  // ("puzzle-generation-dev" vs "puzzle-generation") are a pre-existing
  // mismatch carried forward as-is — out of scope for this change. The
  // staging/production envs below use matching names, so this mismatch is
  // not repeated there.
  // Workers AI: an image model renders one theme-less (or themed) puzzle
  // image per puzzle.
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Flagship — same "timer" app across every environment, on
  // purpose: it's how every tunable knob this service has gets changed
  // without a redeploy (see puzzle.constants.ts, and @game-worker/shared's
  // lobby.ts/game-session.ts for the two flags below shared with `guess`).
  // No "dev-mode" flag any more — each knob is just its own flag, so
  // testing a different value means changing that flag directly instead of
  // flipping a mode and hoping a second "-override-" flag holds what you
  // want. This service's own flags: "puzzle-time-seconds",
  // "grid-size-default", "grid-size-min", "grid-size-max",
  // "puzzle-max-score", "puzzle-min-solved-score". Shared with `guess`
  // (exact same flag key, read independently by each service):
  // "lobby-countdown-seconds", "max-theme-length", "max-player-length",
  // "preset-themes" (see @game-worker/shared's ai.ts — an object/array flag
  // of curated theme strings; leave unset/empty to let the model keep
  // inventing its own theme when a puzzle doesn't have one).
  // `guess` also has its own guess-time-*/round-count/guess-*-score/
  // post-round-seconds flags on this same app.
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
    }
  ],
  // Shared with `guess` — puzzle source images live at
  // `puzzles/<puzzleId>/source.png` (see puzzle.constants.ts).
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "game-guess-images"
    }
  ],
  // The custom domain connected to the `IMAGES` bucket above — see
  // apps/browse/wrangler.jsonc's fuller comment on this var. `sourceImageUrl`
  // (see puzzle.model.ts's `readPublicState()`) points straight at this
  // domain instead of a GET /puzzles/{id}/image route on this Worker.
  "vars": {
    "IMAGES_PUBLIC_URL": "https://dev.images.ryanb.co.za"
  },
  // No D1 binding here on purpose — this service has no tables of its own.
  // Catalog status and score recording go through the BROWSE/LEADERBOARD
  // RPC bindings below instead of a direct database binding.
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "game-accounts-worker",
      "entrypoint": "AccountsService"
    },
    {
      "binding": "BROWSE",
      "service": "game-browse-worker",
      "entrypoint": "CatalogService"
    },
    {
      "binding": "LEADERBOARD",
      "service": "game-leaderboard-worker",
      "entrypoint": "LeaderboardService"
    }
  ],
  // One DO instance per puzzle (getByName(puzzleId)). Owns its own SQLite
  // state and pushes live progress over a hibernatable WebSocket; a DO
  // alarm enforces the lobby auto-start and play countdown server-side.
  "durable_objects": {
    "bindings": [
      {
        "name": "PUZZLE_DO",
        "class_name": "PuzzleDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PuzzleDO"
      ]
    }
  ],
  // POST /puzzles enqueues a generation job; the queue consumer (same
  // Worker) does the actual AI work off the request path.
  "queues": {
    "producers": [
      {
        "queue": "puzzle-generation-dev",
        "binding": "PUZZLE_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "puzzle-generation",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "puzzle-generation-dlq"
      }
    ]
  },
  // See apps/accounts/wrangler.jsonc for why binding arrays are fully
  // re-declared per named environment rather than inherited. Each named
  // env's service bindings target the sibling Workers deployed to the
  // *same* environment; queues/R2 bucket are separate physical resources
  // per env so staging/prod generation traffic never touches dev data.
  "env": {
    "staging": {
      "name": "game-puzzle-worker-staging",
      "routes": [
        {
          "pattern": "staging.api.puzzle.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "game-guess-images-staging"
        }
      ],
      "vars": {
        "IMAGES_PUBLIC_URL": "https://staging.images.ryanb.co.za"
      },
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-staging",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "BROWSE",
          "service": "game-browse-worker-staging",
          "entrypoint": "CatalogService"
        },
        {
          "binding": "LEADERBOARD",
          "service": "game-leaderboard-worker-staging",
          "entrypoint": "LeaderboardService"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PUZZLE_DO",
            "class_name": "PuzzleDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "PuzzleDO"
          ]
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "puzzle-generation-staging",
            "binding": "PUZZLE_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "puzzle-generation-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "puzzle-generation-dlq-staging"
          }
        ]
      }
    },
    "production": {
      "name": "game-puzzle-worker-prod",
      // Prod-only OTel export — see apps/accounts/wrangler.jsonc for what
      // "k8s-logs"/"k8s" are and why this only appears here.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "destinations": [
            "k8s-logs"
          ],
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "destinations": [
            "k8s"
          ],
          "head_sampling_rate": 1
        }
      },
      "routes": [
        {
          "pattern": "api.puzzle.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "cd275eff-6429-4571-a8e7-c6e2a5c8b160"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "game-guess-images-prod"
        }
      ],
      "vars": {
        "IMAGES_PUBLIC_URL": "https://images.ryanb.co.za"
      },
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-prod",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "BROWSE",
          "service": "game-browse-worker-prod",
          "entrypoint": "CatalogService"
        },
        {
          "binding": "LEADERBOARD",
          "service": "game-leaderboard-worker-prod",
          "entrypoint": "LeaderboardService"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PUZZLE_DO",
            "class_name": "PuzzleDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "PuzzleDO"
          ]
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "puzzle-generation-prod",
            "binding": "PUZZLE_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "puzzle-generation-prod",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "puzzle-generation-dlq-prod"
          }
        ]
      }
    }
  }
}
