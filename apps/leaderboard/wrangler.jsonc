{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "game-leaderboard-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom Domain per environment — see apps/accounts/wrangler.jsonc for
  // the naming scheme and the session-cookie caveat.
  "routes": [
    {
      "pattern": "dev.api.leaderboard.ryanb.co.za",
      "custom_domain": true
    }
  ],
  // Owns `leaderboard_entries` (see catalog.service.ts-style ownership
  // comment) and also reads (never writes) `users` directly for display
  // names — a pragmatic read against the shared physical database rather
  // than N RPC round trips per top-10 list. Session lookups still go
  // through the ACCOUNTS RPC binding below, since that's stateful
  // behavior (expiry checks), not a plain display-name join.
  // Unnamed/top-level config == "dev" (deployed as `game-leaderboard-worker`,
  // no --env flag needed).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-worker-catalog",
      "database_id": "cd1e3d8e-eec2-4020-91b6-7adf07247d06",
      "migrations_dir": "../../migrations"
    }
  ],
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "game-accounts-worker",
      "entrypoint": "AccountsService"
    }
  ],
  // See apps/accounts/wrangler.jsonc for why binding arrays are fully
  // re-declared per named environment rather than inherited. Each named
  // env's ACCOUNTS binding targets the sibling `accounts` Worker deployed
  // to the *same* environment.
  "env": {
    "staging": {
      "name": "game-leaderboard-worker-staging",
      "routes": [
        {
          "pattern": "staging.api.leaderboard.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-staging",
          "database_id": "75c2c0c7-0671-48bb-a183-6add29839f9d",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-staging",
          "entrypoint": "AccountsService"
        }
      ]
    },
    "production": {
      "name": "game-leaderboard-worker-prod",
      // Prod-only OTel export — see apps/accounts/wrangler.jsonc for what
      // "k8s-logs"/"k8s" are and why this only appears here.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "destinations": [
            "k8s-logs"
          ],
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "destinations": [
            "k8s"
          ],
          "head_sampling_rate": 1
        }
      },
      "routes": [
        {
          "pattern": "api.leaderboard.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-prod",
          "database_id": "44482ca7-ce2a-4d7a-a2f4-64e4d4825637",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-prod",
          "entrypoint": "AccountsService"
        }
      ]
    }
  }
}
