{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "game-notifications-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom Domain per environment — see apps/accounts/wrangler.jsonc for
  // the naming scheme and the session-cookie caveat.
  "routes": [
    {
      "pattern": "dev.api.notifications.ryanb.co.za",
      "custom_domain": true
    }
  ],
  // Owns `notifications` — a generic, dynamically-typed per-user inbox (see
  // notifications.service.ts/db/schema.ts). This is the main way every
  // other service pushes a user-facing message: over the `NotificationsService`
  // RPC entrypoint (see index.ts), never by writing this table directly.
  // Unnamed/top-level config == "dev" (deployed as `game-notifications-worker`,
  // no --env flag needed).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-worker-catalog",
      "database_id": "cd1e3d8e-eec2-4020-91b6-7adf07247d06",
      "migrations_dir": "../../migrations"
    }
  ],
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "game-accounts-worker",
      "entrypoint": "AccountsService"
    }
  ],
  // One DO instance per user (getByName(userId)) — a pure WebSocket
  // delivery channel, no storage of its own (see notification.model.ts).
  // Formerly apps/friends' `UserDO`, invite-only; this is its generalized
  // successor, shared by every service.
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_DO",
        "class_name": "NotificationDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotificationDO"
      ]
    }
  ],
  // See apps/accounts/wrangler.jsonc for why binding arrays are fully
  // re-declared per named environment rather than inherited. DO migrations
  // start fresh per env (a `-staging`/`-prod` script has no prior DO
  // history of its own).
  "env": {
    "staging": {
      "name": "game-notifications-worker-staging",
      "routes": [
        {
          "pattern": "staging.api.notifications.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-staging",
          "database_id": "75c2c0c7-0671-48bb-a183-6add29839f9d",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-staging",
          "entrypoint": "AccountsService"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATION_DO",
            "class_name": "NotificationDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "NotificationDO"
          ]
        }
      ]
    },
    "production": {
      "name": "game-notifications-worker-prod",
      // Prod-only OTel export — see apps/accounts/wrangler.jsonc for what
      // "k8s-logs"/"k8s" are and why this only appears here.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "destinations": [
            "k8s-logs"
          ],
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "destinations": [
            "k8s"
          ],
          "head_sampling_rate": 1
        }
      },
      "routes": [
        {
          "pattern": "api.notifications.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-prod",
          "database_id": "44482ca7-ce2a-4d7a-a2f4-64e4d4825637",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-prod",
          "entrypoint": "AccountsService"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATION_DO",
            "class_name": "NotificationDO"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "NotificationDO"
          ]
        }
      ]
    }
  }
}
