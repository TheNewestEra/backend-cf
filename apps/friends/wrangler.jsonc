{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "game-friends-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom Domain per environment — see apps/accounts/wrangler.jsonc for
  // the naming scheme and the session-cookie caveat.
  "routes": [
    {
      "pattern": "dev.api.friends.ryanb.co.za",
      "custom_domain": true
    }
  ],
  // Owns `friend_requests`, `friendships`, `friend_groups`,
  // `friend_group_members`, `game_invites`. Display names/colors come from
  // the ACCOUNTS RPC binding below (`getUsersByIds`/`findUserByUsername`),
  // never a direct read against `users` — see friends.service.ts.
  // Unnamed/top-level config == "dev" (deployed as `game-friends-worker`,
  // no --env flag needed).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-worker-catalog",
      "database_id": "cd1e3d8e-eec2-4020-91b6-7adf07247d06",
      "migrations_dir": "../../migrations"
    }
  ],
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "game-accounts-worker",
      "entrypoint": "AccountsService"
    },
    {
      "binding": "PUZZLE",
      "service": "game-puzzle-worker",
      "entrypoint": "PuzzleService"
    },
    {
      "binding": "GUESS",
      "service": "game-guess-worker",
      "entrypoint": "GuessService"
    },
    {
      "binding": "NOTIFICATIONS",
      "service": "game-notifications-worker",
      "entrypoint": "NotificationsService"
    }
  ],
  // The old per-user `UserDO` (an invite-only WebSocket relay) has moved to
  // apps/notifications' `NotificationDO`, reached via the NOTIFICATIONS
  // binding above instead of a Durable Object namespace binding of this
  // Worker's own — see apps/notifications/wrangler.jsonc and this app's
  // friends.controller.ts (`POST /api/invites` now calls
  // `NOTIFICATIONS.push()`). `deleted_classes` below actually decommissions
  // the class (rather than just dropping its binding, which would leave it
  // running, unreachable, forever) — safe here specifically because
  // `UserDO` never stored anything in its own `ctx.storage`, just relayed
  // live WebSocket messages.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserDO"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "UserDO"
      ]
    }
  ],
  // See apps/accounts/wrangler.jsonc for why binding arrays are fully
  // re-declared per named environment rather than inherited. Each named
  // env's service bindings target the sibling Workers deployed to the
  // *same* environment. DO migrations start fresh per env (a `-staging`/
  // `-prod` script has no prior DO history of its own).
  "env": {
    "staging": {
      "name": "game-friends-worker-staging",
      "routes": [
        {
          "pattern": "staging.api.friends.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-staging",
          "database_id": "75c2c0c7-0671-48bb-a183-6add29839f9d",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-staging",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "PUZZLE",
          "service": "game-puzzle-worker-staging",
          "entrypoint": "PuzzleService"
        },
        {
          "binding": "GUESS",
          "service": "game-guess-worker-staging",
          "entrypoint": "GuessService"
        },
        {
          "binding": "NOTIFICATIONS",
          "service": "game-notifications-worker-staging",
          "entrypoint": "NotificationsService"
        }
      ],
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "UserDO"
          ]
        },
        {
          "tag": "v2",
          "deleted_classes": [
            "UserDO"
          ]
        }
      ]
    },
    "production": {
      "name": "game-friends-worker-prod",
      // Prod-only OTel export — see apps/accounts/wrangler.jsonc for what
      // "k8s-logs"/"k8s" are and why this only appears here.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "destinations": [
            "k8s-logs"
          ],
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "destinations": [
            "k8s"
          ],
          "head_sampling_rate": 1
        }
      },
      "routes": [
        {
          "pattern": "api.friends.ryanb.co.za",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "game-worker-catalog-prod",
          "database_id": "44482ca7-ce2a-4d7a-a2f4-64e4d4825637",
          "migrations_dir": "../../migrations"
        }
      ],
      "services": [
        {
          "binding": "ACCOUNTS",
          "service": "game-accounts-worker-prod",
          "entrypoint": "AccountsService"
        },
        {
          "binding": "PUZZLE",
          "service": "game-puzzle-worker-prod",
          "entrypoint": "PuzzleService"
        },
        {
          "binding": "GUESS",
          "service": "game-guess-worker-prod",
          "entrypoint": "GuessService"
        },
        {
          "binding": "NOTIFICATIONS",
          "service": "game-notifications-worker-prod",
          "entrypoint": "NotificationsService"
        }
      ],
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "UserDO"
          ]
        },
        {
          "tag": "v2",
          "deleted_classes": [
            "UserDO"
          ]
        }
      ]
    }
  }
}
